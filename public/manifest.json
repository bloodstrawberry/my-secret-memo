{
  "manifest_version": 3,
  "name": "My Personal Markdown Memo",
  "version": "1.0.0",
  "description": "A simple and beautiful markdown notepad.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Memo"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "favicon.ico",
    "48": "favicon.ico",
    "128": "favicon.ico"
  }
}
